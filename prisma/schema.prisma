// ICT Equipment & Borrowing Management System - central MySQL schema.
// Mirrors the SQL contract documented in CLAUDE.md.
//
// MySQL has no native UUID column type, so ids are CHAR(36) — fixed width keeps
// them index-friendly. Timestamps use DATETIME(3) rather than TIMESTAMP because
// TIMESTAMP tops out in 2038 and loan due dates must outlive that.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id              String    @id @default(uuid()) @db.Char(36)
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  customFields    Json      @map("custom_fields")
  defaultLoanDays Int       @default(7) @map("default_loan_days")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)

  equipment Equipment[]

  @@index([updatedAt])
  @@map("categories")
}

model Equipment {
  id             String    @id @default(uuid()) @db.Char(36)
  assetTag       String    @unique @map("asset_tag") @db.VarChar(100)
  serialNumber   String?   @unique @map("serial_number") @db.VarChar(100)
  categoryId     String?   @map("category_id") @db.Char(36)
  modelName      String    @map("model_name") @db.VarChar(255)
  brand          String?   @db.VarChar(100)
  status         String    @default("AVAILABLE") @db.VarChar(50)
  condition      String    @default("GOOD") @db.VarChar(50)
  location       String?   @db.VarChar(255)
  specifications Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  category     Category?              @relation(fields: [categoryId], references: [id])
  transactions BorrowingTransaction[]

  @@index([categoryId])
  @@index([status])
  @@index([updatedAt])
  @@map("equipment")
}

model BorrowingTransaction {
  id                 String    @id @default(uuid()) @db.Char(36)
  equipmentId        String?   @map("equipment_id") @db.Char(36)
  borrowerName       String    @map("borrower_name") @db.VarChar(255)
  borrowerEmail      String    @map("borrower_email") @db.VarChar(255)
  issueDate          DateTime  @map("issue_date") @db.DateTime(3)
  expectedReturnDate DateTime  @map("expected_return_date") @db.DateTime(3)
  actualReturnDate   DateTime? @map("actual_return_date") @db.DateTime(3)
  status             String    @default("ISSUED") @db.VarChar(50)
  notes              String?   @db.Text
  // Populated by the sync conflict engine when a dual-checkout is detected.
  conflictReason     String?   @map("conflict_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime? @map("deleted_at") @db.DateTime(3)

  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@index([status])
  @@index([updatedAt])
  @@map("borrowing_transactions")
}

/// Append-only audit log of every mutation accepted by /api/sync/push.
model SyncChange {
  id              String   @id @default(uuid()) @db.Char(36)
  entityType      String   @map("entity_type") @db.VarChar(50)
  entityId        String   @map("entity_id") @db.Char(36)
  operation       String   @db.VarChar(20)
  data            Json
  clientId        String?  @map("client_id") @db.VarChar(100)
  clientTimestamp DateTime @map("client_timestamp") @db.DateTime(3)
  syncedAt        DateTime @default(now()) @map("synced_at") @db.DateTime(3)

  @@index([entityType, entityId])
  @@index([syncedAt])
  @@map("sync_changes")
}
