# Production environment for the Vue client.
# Copy to /var/www/ict-inventory/web/.env.production before running the build.
#
# These are baked into the bundle at build time, so changing them means
# rebuilding — they are not read at runtime.

# Same origin as the SPA, so the browser makes no cross-origin request at all.
VITE_API_URL=/api

# UI hint only. The API is the authority on who may sign in.
VITE_ALLOWED_EMAIL_DOMAINS=dswd.gov.ph
