# Production environment for the Laravel API.
# Copy to /var/www/ict-inventory/api/.env and fill in the marked values.
#
#   cp deploy/api.env.production.example api/.env
#   php artisan key:generate
#
# Never commit the filled-in file: it holds the app key, the database password
# and the mailbox password.

APP_NAME="ICT Inventory API"
APP_ENV=production
APP_KEY=                                    # <-- php artisan key:generate
APP_DEBUG=false
APP_URL=https://inventory.example.gov.ph    # <-- change

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Asia/Manila keeps log timestamps readable locally. Application data stays UTC
# regardless — see the DATETIME(3) note in CLAUDE.md.
APP_TIMEZONE=UTC

# 'daily' rotates; 'single' grows until the disk is full.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----------------------------------------------------------------- database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ict_inventory
DB_USERNAME=ict_inventory                   # <-- not root
DB_PASSWORD=                                # <-- change

# ------------------------------------------------------------------- caches
# 'database' avoids needing Redis for a single-server deployment. The tables are
# created by the framework's own migrations, which already ran.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --------------------------------------------------------------------- CORS
# Origins allowed to call this API. With the SPA on the same host this is only
# needed for other consumers, but keep it accurate — it is a security control.
FRONTEND_URLS=https://inventory.example.gov.ph

# ------------------------------------------------------------------ accounts
ACCOUNT_EMAIL_DOMAINS=dswd.gov.ph
SEED_ADMIN_EMAIL=icts.fo11@dswd.gov.ph
SEED_ADMIN_NAME="ICT Administrator"

# ---------------------------------------------------------------------- mail
# Sign-in codes are useless if mail does not leave the server. Verify with:
#   php artisan tinker --execute="Mail::raw('test', fn(\$m) => \$m->to('you@dswd.gov.ph')->subject('test'));"
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=icts.fo11@dswd.gov.ph
MAIL_PASSWORD=                              # <-- Google app password
MAIL_EHLO_DOMAIN=dswd.gov.ph
MAIL_FROM_ADDRESS="icts.fo11@dswd.gov.ph"
MAIL_FROM_NAME="DSWD FO11 ICT Section"
MAIL_OTP_FROM_ADDRESS=icts.fo11@dswd.gov.ph
MAIL_OTP_FROM_NAME="DSWD FO11 ICT Section"
