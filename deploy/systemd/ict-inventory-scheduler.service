# Laravel scheduler (prunes expired sign-in codes and stale API tokens).
#
# A systemd timer is used instead of a crontab entry so the schedule is version
# controlled and its output lands in the journal rather than root's mail spool.
#
#   sudo cp deploy/systemd/ict-inventory-scheduler.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ict-inventory-scheduler.timer
#   systemctl list-timers ict-inventory-scheduler.timer

[Unit]
Description=ICT Inventory scheduled tasks
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/ict-inventory/api
ExecStart=/usr/bin/php artisan schedule:run

# The scheduler only reads and prunes; it needs no wider access than that.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/ict-inventory/api/storage
