# Production environment for the Vue client.
# Copy to /var/www/ict-inventory/web/.env.production before running the build.
#
# These are baked into the bundle at build time, so changing any of them means
# rebuilding — they are not read at runtime.

# Subdirectory the SPA is mounted at. MUST have a trailing slash: Vite prefixes
# every asset URL with it and the vue-router history base is derived from it.
VITE_BASE_PATH=/inventory_management/

# Same origin as the SPA, so the browser makes no cross-origin request.
# Note the trailing /api — that is Laravel's own route prefix, which sits inside
# the /inventory_management_api mount point.
VITE_API_URL=/inventory_management_api/api

# UI hint only. The API is the authority on who may sign in.
VITE_ALLOWED_EMAIL_DOMAINS=dswd.gov.ph
